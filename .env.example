# Required email login. Use the Supabase publishable key, never the service-role key.
APP_ORIGIN=http://127.0.0.1:3100
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated approved users, also provisioned in Supabase Auth.
AUTH_ALLOWED_EMAILS=

# Optional shared financial storage. Without Redis, Vercel uses browser-local data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
